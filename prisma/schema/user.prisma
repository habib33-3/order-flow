model User {
    id       String @id @default(cuid())
    email    String @unique
    name     String
    password String

    role   UserRole   @default(USER)
    status UserStatus @default(PENDING)

    phone     String? @unique
    avatarUrl String?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    lastLoginAt DateTime?

    orders            Order[]
    payments          Payment[]
    shippingAddresses ShippingAddress[]
    carts             Cart[]
    couponRedeems     CouponRedeem[]
    platformReviews   PlatformReview[]

    @@index([role])
    @@map("users")
}

enum UserRole {
    ADMIN
    USER
}

enum UserStatus {
    PENDING
    ACTIVE
    SUSPENDED
}
