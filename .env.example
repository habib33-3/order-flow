# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string.
#
# Format:
# postgresql://<username>:<password>@<host>:<port>/<database>
#
# Example:
# postgresql://postgres:password@localhost:5432/order-flow
DATABASE_URL="postgresql://user:password@localhost:5432/order-flow"

# =============================================================================
# Redis
# =============================================================================
# Redis connection string.
#
# Format:
# redis://<host>:<port>
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Authentication (JWT)
# =============================================================================
# Generate each secret with:
#
# openssl rand -base64 32
#
# Example output:
# ehLXBp7diCJZq6tcs5WZHp6YDmM9ig+NW+gNCOsEcRs=

# Secret used to sign access tokens.
ACCESS_TOKEN_SECRET="your-access-token-secret"

# Access token lifetime.
# Examples: 15m, 30m, 1h
ACCESS_TOKEN_EXPIRES="15m"

# Secret used to sign refresh tokens.
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Refresh token lifetime.
# Examples: 7d, 30d
REFRESH_TOKEN_EXPIRES="7d"

# Secret used to sign password reset tokens.
PASSWORD_RESET_TOKEN_SECRET="your-password-reset-token-secret"

# =============================================================================
# Application
# =============================================================================
# Frontend application URL.
CLIENT_URL="http://localhost:3000"

# Backend API URL.
SERVER_URL="http://localhost:5000"

# Application name.
APP_NAME="order-flow"

# =============================================================================
# Stripe
# =============================================================================
# Create API keys:
# https://dashboard.stripe.com/apikeys

# Secret API key.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Publishable API key.
STRIPE_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook signing secret.
# Create this after registering a webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# bKash (Sandbox)
# =============================================================================
# Create a developer account:
# https://developer.bka.sh/

# Sandbox API base URL.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized"

# Sandbox credentials.
BKASH_USERNAME="sandboxTokenizedUser02"
BKASH_PASSWORD="sandboxTokenizedUser02@12345"

# Sandbox application credentials.
BKASH_APP_KEY="your-bkash-app-key"
BKASH_APP_SECRET="your-bkash-app-secret"

# =============================================================================
# Resend (Email)
# =============================================================================
# Create an API key:
# https://resend.com/api-keys

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender email address.
#
# For testing you can use:
# onboarding@resend.dev
#
# For production, use a verified domain.
EMAIL_FROM_EMAIL="onboarding@resend.dev"

# =============================================================================
# Cloudinary
# =============================================================================
# Find your credentials in the Cloudinary Dashboard:
# https://cloudinary.com/console

# Cloud name.
CLOUDINARY_CLOUD_NAME="your-cloud-name"

# API key.
CLOUDINARY_API_KEY="your-api-key"

# API secret.
CLOUDINARY_API_SECRET="your-api-secret"

SHOW_BULL_BOARD=false